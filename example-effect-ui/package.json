{
  "name": "party-db-example-effect-ui",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n worker,client \"npm:dev:worker\" \"npm:dev:client\"",
    "dev:worker": "cross-env CLOUDFLARE_CF_FETCH_ENABLED=false wrangler dev",
    "dev:client": "vite",
    "build": "vite build",
    "build:worker": "wrangler deploy --dry-run",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.worker.json"
  },
  "dependencies": {
    "@effect/ui": "https://pkg.pr.new/Effect-TS/ui/@effect/ui@22128c6",
    "@tanstack/db": "^0.15.2",
    "effect": "^4.1.7",
    "partyserver": "^0.5.8",
    "partysocket": "^1.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4",
    "concurrently": "^9",
    "cross-env": "^7",
    "typescript": "^7.0.2",
    "vite": "^6",
    "wrangler": "^4"
  }
}
