{
  "name": "party-db-example",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n worker,client \"npm:dev:worker\" \"npm:dev:client\"",
    "dev:worker": "cross-env CLOUDFLARE_CF_FETCH_ENABLED=false wrangler dev",
    "dev:client": "vite",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.worker.json"
  },
  "dependencies": {
    "@tanstack/db": "^0.6.10",
    "partyserver": "^0.5.8",
    "partysocket": "^1.3.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4",
    "concurrently": "^9",
    "cross-env": "^7",
    "typescript": "^5.7",
    "vite": "^6",
    "wrangler": "^4"
  }
}
