{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "composite": true,
    "tsBuildInfoFile": "node_modules/.tmp/app.tsbuildinfo",
    "types": [
      "vite/client"
    ]
  },
  "include": [
    "src",
    "party-app/client.ts",
    "party-app/protocol.ts",
    "shared"
  ],
  "references": [
    {
      "path": "./tsconfig.worker.json"
    }
  ]
}